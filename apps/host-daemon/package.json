{
  "name": "@bb/host-daemon",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "exports": {
    "./test": {
      "source": "./src/test/index.ts",
      "types": "./src/test/index.ts",
      "default": "./src/test/index.ts"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-node-entry.mjs src/index.ts dist/index.js --clean-dist --external ./start-host-daemon.js && node ../../scripts/build-node-entry.mjs src/start-host-daemon.ts dist/start-host-daemon.js && node ../../scripts/build-node-entry.mjs src/plugin-host-worker.ts dist/plugin-host-worker.js && node ./scripts/build-bundles.mjs",
    "bundle": "node ./scripts/build-bundles.mjs",
    "start": "node dist/index.js",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "dev": "node --conditions=source --import tsx scripts/dev-supervisor.mjs",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@bb/agent-runtime": "workspace:*",
    "@bb/cli": "workspace:*",
    "@bb/connect-client": "workspace:*",
    "@bb/config": "workspace:*",
    "@bb/domain": "workspace:*",
    "@bb/fuzzy-match": "workspace:*",
    "@bb/host-daemon-contract": "workspace:*",
    "@bb/local-open-targets": "workspace:*",
    "@bb/host-watcher": "workspace:*",
    "@bb/host-workspace": "workspace:*",
    "@bb/logger": "workspace:*",
    "@bb/process-utils": "workspace:*",
    "@bb/provider-bridge-protocol": "workspace:*",
    "@bb/templates": "workspace:*",
    "@bb/tunnel-client": "workspace:*",
    "@bb/tunnel-contract": "workspace:*",
    "@hono/node-server": "^1.19.11",
    "@parcel/watcher": "2.5.6",
    "better-sqlite3": "12.10.0",
    "gray-matter": "^4.0.3",
    "jiti": "^2.6.1",
    "mime-types": "^3.0.2",
    "node-pty": "1.2.0-beta.15",
    "p-retry": "^6.2.1",
    "partysocket": "^1.3.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "proper-lockfile": "^4.1.2",
    "semver": "^7.7.4",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@bb/scripts": "workspace:*",
    "@bb/test-helpers": "workspace:*",
    "@bb/tsconfig": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.1",
    "esbuild": "^0.28.0",
    "hono": "^4.7.0",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2"
  }
}
