{
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["@get-bb/plugin-sdk#build:types"]
    },
    "build": {
      "dependsOn": ["@get-bb/plugin-sdk#build:types", "@bb/cli#build"],
      "cache": false
    },
    "test": {
      "dependsOn": ["@get-bb/plugin-sdk#build:types"],
      "cache": false
    },
    "smoke": {
      "cache": false,
      "dependsOn": ["@get-bb/plugin-sdk#build:types"],
      "passThroughEnv": [
        "DEV_BROWSER_SMOKE_BINARY",
        "DEV_BROWSER_SMOKE_CHROME",
        "DEV_BROWSER_SMOKE_NO_SANDBOX"
      ]
    },
    "smoke:install": {
      "cache": false,
      "dependsOn": ["@get-bb/plugin-sdk#build:types"],
      "passThroughEnv": [
        "DEV_BROWSER_SMOKE_CHROME",
        "DEV_BROWSER_SMOKE_NO_SANDBOX"
      ]
    }
  }
}
