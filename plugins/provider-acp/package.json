{
  "name": "bb-plugin-provider-acp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run bb threads with ACP agents (supports Cursor, opencode, omp and more).",
  "engines": {
    "bb": ">=0.0"
  },
  "bb": {
    "name": "ACP providers",
    "description": "Run bb threads with ACP agents (supports Cursor, opencode, omp and more).",
    "branding": {
      "icon": "./icons/acp.svg",
      "experimental_icons": {
        "cursor": "./icons/cursor.svg",
        "opencode": "./icons/opencode.svg",
        "omp": "./icons/omp.svg",
        "grok": "./icons/grok.svg",
        "hermes-agent": "./icons/hermes-agent.svg",
        "junie": "./icons/junie.svg"
      }
    },
    "server": "./server.ts",
    "host": "./src/host.ts"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^22.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "workspace:*",
    "smol-toml": "^1.7.1",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  }
}
