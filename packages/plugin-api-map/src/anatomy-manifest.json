        "rounded-full bg-warning"
      ],
      "sources": [
        {
          "path": "apps/app/src/components/plugin/PluginSidebarFooterItems.tsx",
          "anchors": [
            "\"aria-expanded\": isActive",
            "onDisclosureCommand(itemKey, \"toggle\")",
            "<Component dismiss={onDismiss} />"
          ]
        },
        {
          "path": "packages/plugin-sdk/src/internal/plugin-app-collector.ts",
          "anchors": [
            "adaptSidebarFooterAction",
            "experimental_sidebarFooter.register",
            "registration.kind === \"action\"",
            "registration.kind === \"disclosure\""
          ]
        },
        {
          "path": "apps/app/src/components/plugin/PluginSidebarFooterItems.test.tsx",
          "anchors": [
            "toggles and dismisses a disclosure accessibly",
            "lets the host coordinate disclosures from multiple plugins"
          ]
        }
      ]
    }
  }
}
